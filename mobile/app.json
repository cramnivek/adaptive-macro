{
  "expo": {
    "name": "Ascend",
    "slug": "adaptive-macros",
    "owner": "zeldrich",
    "scheme": "ascend",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.cramnivek.ascend",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan barcodes on food packaging, and photograph a meal or a printed programme so the app can estimate it or read it.",
        "NSPhotoLibraryUsageDescription": "Choose a photo of a meal, or a screenshot of a training programme, for the app to estimate or read."
      }
    },
    "android": {
      "package": "com.cramnivek.ascend",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_HEALTH_DATA_HISTORY"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan barcodes on food packaging, and photograph a meal or a printed programme so the app can estimate it or read it."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo of a meal, or a screenshot of a training programme, for the app to estimate or read.",
          "cameraPermission": "Scan barcodes on food packaging, and photograph a meal or a printed programme so the app can estimate it or read it.",
          "microphonePermission": false
        }
      ],
      "expo-video",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF8",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0E0E0F"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1feb7a8d-afb9-479d-8e29-821bb5be74c6"
      }
    }
  }
}
